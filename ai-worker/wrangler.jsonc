{
  "name": "soap-ai-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "vars": {
    "ALLOWED_ORIGIN": "https://medicsoap.com"
  },
  "ratelimits": [
    {
      "name": "NARRATIVE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
